{
  "$schema": "https://raw.githubusercontent.com/EmmyLuaLs/emmylua-analyzer-rust/refs/heads/main/crates/emmylua_code_analysis/resources/schema.json",
  "diagnostics": {
    "globals": ["vim"]
  },
  "runtime": {
    "version": "LuaJIT"
  },
  "workspace": {
    "library": [
      "{env:VIMRUNTIME}",
      {
        "path": "{env:HOME}/.local/share/nvim/lazy",
        "ignoreGlobs": [
          "**/test/**",
          "**/tests/**",
          "**/spec/**",
          "**/*.spec.lua",
          "**/examples/**"
        ]
      }
    ]
  }
}
